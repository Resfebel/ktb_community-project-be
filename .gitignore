# created by virtualenv automatically
# ------------------------------------
# 1. 환경 폴더 및 캐시
# ------------------------------------
venv/                 # 가상 환경 폴더 (이미 있을 가능성 높음)
env/                  # 다른 이름의 가상 환경 폴더
__pycache__/          # 파이썬 바이트 코드 캐시 폴더
*.pyc                 # 컴파일된 파이썬 파일

# ------------------------------------
# 2. PyCharm 및 OS 관련 파일
# ------------------------------------
.idea/                # PyCharm 프로젝트 설정 폴더
.DS_Store             # macOS에서 자동으로 생성되는 파일
*.log                 # 로그 파일

# ------------------------------------
# 3. 비밀 파일 및 데이터
# ------------------------------------
.env                  # 환경 변수 파일 (실제 키가 담기는 곳)

# ------------------------------------
# 4. AI 모델 이그노어
# ------------------------------------
*.pt
*.pth
*.h5
*.weights
